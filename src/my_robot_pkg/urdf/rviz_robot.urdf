<?xml version="1.0"?>
<robot name="tank_robot">

  <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
  <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>
  <material name="red"><color rgba="1 0 0 1"/></material>
  <material name="orange"><color rgba="1 0.5 0 1"/></material>

  <!-- Корневой фрейм -->
  <link name="base_footprint"/>

  <!-- Шасси -->
  <link name="base_link">
    <visual>
      <geometry><box size="0.4 0.25 0.08"/></geometry>
      <material name="black"/>
    </visual>
    <collision><geometry><box size="0.4 0.25 0.08"/></geometry></collision>
    <inertial>
      <mass value="5.0"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
  </link>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
  </joint>

  <!-- Возвышение -->
  <link name="tower_link">
    <visual>
      <origin xyz="0 0 0.06"/>
      <geometry><box size="0.15 0.15 0.12"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.06"/>
      <geometry><box size="0.15 0.15 0.12"/></geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>
  <joint name="tower_joint" type="fixed">
    <parent link="base_link"/>
    <child link="tower_link"/>
    <origin xyz="-0.05 0 0.04" rpy="0 0 0"/>
  </joint>

  <!-- Лидар -->
  <link name="laser_frame">
    <visual>
      <geometry><cylinder radius="0.04" length="0.05"/></geometry>
      <material name="red"/>
    </visual>
    <collision><geometry><cylinder radius="0.04" length="0.05"/></geometry></collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="tower_link"/>
    <child link="laser_frame"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
  </joint>

  <!-- Колесо 1: front_left -->
  <link name="front_left_wheel">
    <visual>
      <geometry><cylinder radius="0.06" length="0.03"/></geometry>
      <material name="orange"/>
    </visual>
    <collision><geometry><cylinder radius="0.06" length="0.03"/></geometry></collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_left_wheel"/>
    <origin xyz="0.13 0.14 -0.04" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- Колесо 2: rear_left -->
  <link name="rear_left_wheel">
    <visual>
      <geometry><cylinder radius="0.06" length="0.03"/></geometry>
      <material name="orange"/>
    </visual>
    <collision><geometry><cylinder radius="0.06" length="0.03"/></geometry></collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_wheel"/>
    <origin xyz="-0.13 0.14 -0.04" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- Колесо 3: front_right -->
  <link name="front_right_wheel">
    <visual>
      <geometry><cylinder radius="0.06" length="0.03"/></geometry>
      <material name="orange"/>
    </visual>
    <collision><geometry><cylinder radius="0.06" length="0.03"/></geometry></collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_right_wheel"/>
    <origin xyz="0.13 -0.14 -0.04" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- Колесо 4: rear_right -->
  <link name="rear_right_wheel">
    <visual>
      <geometry><cylinder radius="0.06" length="0.03"/></geometry>
      <material name="orange"/>
    </visual>
    <collision><geometry><cylinder radius="0.06" length="0.03"/></geometry></collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_wheel"/>
    <origin xyz="-0.13 -0.14 -0.04" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

</robot>